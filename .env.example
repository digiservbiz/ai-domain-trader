# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxx
# Model to use — any model slug from https://openrouter.ai/models
# Free options: mistralai/mistral-7b-instruct:free  meta-llama/llama-3-8b-instruct:free
OPENROUTER_MODEL=openai/gpt-4o-mini
GODADDY_KEY=xxx
GODADDY_SECRET=xxx
GODADDY_SANDBOX=false
REDDIT_CLIENT=xxx
REDDIT_SECRET=xxx
DATABASE_URL=postgresql://trader:trader@db:5432/domains
REDIS_URL=redis://redis:6379/0
# Moz Link Explorer API — https://moz.com/products/api
MOZ_ACCESS_ID=xxx
MOZ_SECRET_KEY=xxx
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=